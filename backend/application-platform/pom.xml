<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.luxera</groupId>
        <artifactId>companion-platform-backend</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>companion-platform-application</artifactId>
    <name>companion-platform-application</name>
    <description>LAP v1 Application Platform — manifest 解析与校验、能力/应用/动作发现、Resource 统一读模型、
        Action 网关(幂等 + 乐观并发)、权限、安装/会话/订阅、生命周期状态机、内置参考应用与 MCP 适配器。
        这是应用作者的宿主: 数字人只能通过 contracts 里的 ApplicationRuntimePort 看见它。</description>

    <dependencies>
        <dependency>
            <groupId>com.luxera</groupId>
            <artifactId>companion-platform-contracts</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
