<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.luxera</groupId>
        <artifactId>companion-platform-backend</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>companion-platform-bootstrap</artifactId>
    <name>companion-platform-bootstrap</name>
    <description>Single-JVM launcher: assembles chat-platform + digital-human-platform + application-platform over
        one Spring context by wiring the in-process adapters for the SPI ports. This is the executable the
        deployment runs while app.topology=single; app.topology=split boots the platforms separately instead.
        It is also the only place where the digital human and the application platform are visible at once —
        hence the boundary guards live in this module's tests.</description>

    <dependencies>
        <dependency>
            <groupId>com.luxera</groupId>
            <artifactId>companion-platform-contracts</artifactId>
        </dependency>
        <dependency>
            <groupId>com.luxera</groupId>
            <artifactId>companion-platform-kernel</artifactId>
        </dependency>
        <dependency>
            <groupId>com.luxera</groupId>
            <artifactId>companion-platform-chat</artifactId>
        </dependency>
        <dependency>
            <groupId>com.luxera</groupId>
            <artifactId>companion-platform-digital-human</artifactId>
        </dependency>
        <dependency>
            <groupId>com.luxera</groupId>
            <artifactId>companion-platform-application</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 跨模块边界守卫: 只有这里同时看得见 chat 与 digital-human -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.0.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.luxera.companion.CompanionApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
